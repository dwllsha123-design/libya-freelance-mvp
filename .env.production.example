# Production stack — copy to `.env` (or `.env.production`) and fill secrets (never commit the filled file)
# Used by:
#   docker compose -f docker-compose.production.yml up -d --build
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d --build
#
# Do not deploy until DNS/hosting is configured.

# --- Domains (Libya Freelance) ---
# Marketplace:  https://libyanfreelance.ly
# Admin:        https://admin.libyanfreelance.ly
# API / WS:     https://api.libyanfreelance.ly

POSTGRES_USER=libya_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=libya_freelance

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=https://libyanfreelance.ly
CORS_ORIGINS=https://libyanfreelance.ly,https://admin.libyanfreelance.ly

NEXT_PUBLIC_SITE_URL=https://libyanfreelance.ly
NEXT_PUBLIC_ADMIN_URL=https://admin.libyanfreelance.ly
NEXT_PUBLIC_API_URL=https://api.libyanfreelance.ly/api
NEXT_PUBLIC_SOCKET_URL=https://api.libyanfreelance.ly

API_PORT=4000
WEB_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3-compatible storage (required — STORAGE_DRIVER=s3)
# Default production compose ships MinIO; point these at R2/Spaces/AWS if you prefer managed S3.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=libya-freelance-prod
S3_BUCKET_NAME=libya-freelance-prod
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY_MIN_8_CHARS
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/libya-freelance-prod
S3_FORCE_PATH_STYLE=true

PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
PAYMENT_SIMULATED_FAILURE=false
PAYMENT_POINTS_GATEWAY_ENABLED=false
EMAIL_FROM=noreply@libyanfreelance.ly
