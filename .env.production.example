# Production stack — copy to .env.production and fill secrets (never commit the filled file)
# Used by: docker compose -f docker-compose.production.yml --env-file .env.production up -d
#
# Do not deploy until DNS/hosting is configured.

# --- Domains (Libya Freelance) ---
# Marketplace:  https://libyanfreelance.ly
# Admin:        https://admin.libyanfreelance.ly
# API / WS:     https://api.libyanfreelance.ly

POSTGRES_USER=libya_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=libya_freelance

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS

FRONTEND_URL=https://libyanfreelance.ly
CORS_ORIGINS=https://libyanfreelance.ly,https://admin.libyanfreelance.ly

NEXT_PUBLIC_SITE_URL=https://libyanfreelance.ly
NEXT_PUBLIC_ADMIN_URL=https://admin.libyanfreelance.ly
NEXT_PUBLIC_API_URL=https://api.libyanfreelance.ly/api
NEXT_PUBLIC_SOCKET_URL=https://api.libyanfreelance.ly

API_PORT=4000
WEB_PORT=3000

# S3-compatible storage (required in production — STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=libya-freelance-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
PAYMENT_SIMULATED_FAILURE=false
