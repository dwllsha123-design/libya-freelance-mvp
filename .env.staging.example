# Staging stack — copy to .env.staging in repo root and fill secrets (never commit filled file)
# Used by: docker compose -f docker-compose.staging.yml --env-file .env.staging

POSTGRES_USER=libya_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=libya_freelance_staging

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS

FRONTEND_URL=https://staging.libyanfreelance.ly
CORS_ORIGINS=https://staging.libyanfreelance.ly
NEXT_PUBLIC_API_URL=https://api-staging.libyanfreelance.ly/api

API_PORT=4000
WEB_PORT=3000

# S3-compatible storage (required for staging API — STORAGE_DRIVER=s3 in compose)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=libya-freelance-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Payments (simulated until a Libyan gateway is integrated)
PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
PAYMENT_SIMULATED_FAILURE=false
