# Railway frontend — copy values into Railway service variables (never commit secrets)
# Root Directory in Railway: /frontend

NODE_ENV=production

# Public URLs. These are inlined at BUILD time, so they must exist as Railway
# service variables before the image is built (a rebuild is required to change
# them). Values below are the production targets.
NEXT_PUBLIC_SITE_URL=https://libyanfreelance.ly
# Drives admin-host detection in middleware — must be the real admin origin.
NEXT_PUBLIC_ADMIN_URL=https://admin.libyanfreelance.ly
NEXT_PUBLIC_API_URL=https://api.libyanfreelance.ly/api
NEXT_PUBLIC_SOCKET_URL=https://api.libyanfreelance.ly

# Allow Next.js <Image> to optimize uploaded media.
# Must be the same scheme+host as the backend's S3_PUBLIC_BASE_URL (no path).
# With a private Railway Bucket, images are served by the API media proxy
# (S3_PUBLIC_BASE_URL=https://api.libyanfreelance.ly/api/media),
# so this is simply the backend origin:
NEXT_PUBLIC_MEDIA_ORIGIN=https://api.libyanfreelance.ly

# Optional: comma-separated extra image hostnames (Railway Bucket CDN, R2, etc.)
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: extra admin hostnames for middleware (comma-separated, no scheme).
# admin.libyanfreelance.ly is already covered by NEXT_PUBLIC_ADMIN_URL above;
# only add hosts here that are not derivable from it.
# ADMIN_HOSTS=

# Railway injects PORT automatically — do not hardcode
