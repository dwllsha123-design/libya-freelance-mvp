# Railway frontend — copy values into Railway service variables (never commit secrets)
# Root Directory in Railway: /frontend

NODE_ENV=production

# Public URLs (use Railway *.up.railway.app domains for staging; custom domains later)
NEXT_PUBLIC_SITE_URL=https://your-frontend.up.railway.app
NEXT_PUBLIC_ADMIN_URL=https://your-frontend.up.railway.app
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api
NEXT_PUBLIC_SOCKET_URL=https://your-backend.up.railway.app

# Optional: allow Next.js <Image> to optimize media from your S3/CDN host
# Set to the same origin as backend S3_PUBLIC_BASE_URL (scheme + host, no path)
NEXT_PUBLIC_MEDIA_ORIGIN=https://your-bucket-public-host.example.com

# Optional: comma-separated extra image hostnames (Railway Bucket CDN, R2, etc.)
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: extra admin hostnames for middleware (comma-separated, no scheme)
# Example when using a dedicated Railway custom domain for admin later:
# ADMIN_HOSTS=admin.your-domain.com

# Railway injects PORT automatically — do not hardcode
