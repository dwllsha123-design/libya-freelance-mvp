generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCER
  CLIENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum FreelancerAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum ProjectBudgetType {
  FIXED
  HOURLY
}

enum ProjectExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  NEW_PROPOSAL
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  NEW_MESSAGE
  PROJECT_COMPLETION_REQUESTED
  PROJECT_COMPLETED
  NEW_REVIEW
  ESCROW_FUNDED
  ESCROW_RELEASED
  ESCROW_DISPUTED
  ESCROW_DISPUTE_RESOLVED
}

enum AdminAuditAction {
  USER_SUSPENDED
  USER_BANNED
  USER_REACTIVATED
  PROJECT_CLOSED
  REVIEW_HIDDEN
  REVIEW_RESTORED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DEACTIVATED
  CATEGORY_ACTIVATED
  SKILL_CREATED
  SKILL_UPDATED
  SKILL_DEACTIVATED
  SKILL_ACTIVATED
  ESCROW_DISPUTE_RESOLVED
}

enum EscrowStatus {
  PENDING_FUNDING
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

enum EscrowTransactionType {
  DEPOSIT
  RELEASE
  REFUND
  PLATFORM_FEE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND_CLIENT
  RESOLVED_RELEASE_FREELANCER
  CLOSED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentPurpose {
  ESCROW_FUNDING
  ESCROW_REFUND
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          Role
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile                 Profile?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  projectsAsClient        Project[]                @relation("ClientProjects")
  completionRequests      Project[]                @relation("CompletionRequests")
  proposals               Proposal[]
  sentMessages            Message[]
  conversationMembers     ConversationMember[]
  reviewsGiven            Review[]                 @relation("ReviewsGiven")
  reviewsReceived         Review[]                 @relation("ReviewsReceived")
  notifications           Notification[]
  adminAuditLogs          AdminAuditLog[]
  escrowsAsClient         Escrow[]                 @relation("EscrowClient")
  escrowsAsFreelancer     Escrow[]                 @relation("EscrowFreelancer")
  escrowTransactions      EscrowTransaction[]      @relation("EscrowTransactionActor")
  escrowDisputesOpened    EscrowDispute[]          @relation("EscrowDisputeOpener")
  escrowDisputesResolved  EscrowDispute[]          @relation("EscrowDisputeResolver")
  payments                Payment[]                @relation("PaymentClient")

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model City {
  id        String   @id @default(uuid())
  nameAr    String   @unique
  slug      String   @unique
  isRemote  Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]
  projects Project[]

  @@index([isActive, sortOrder])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  username     String   @unique
  profilePhoto String?
  bio          String?
  cityId       String?
  country      String   @default("Libya")
  workMode     WorkMode @default(ON_SITE)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  city              City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?

  @@index([username])
  @@index([cityId])
}

model FreelancerProfile {
  id                String                 @id @default(uuid())
  profileId         String                 @unique
  professionalTitle String?
  availability      FreelancerAvailability @default(AVAILABLE)
  hourlyRate        Decimal?               @db.Decimal(12, 2)
  completedProjects Int                    @default(0)
  averageRating     Float                  @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills    FreelancerSkill[]
  portfolio PortfolioItem[]
}

model ClientProfile {
  id             String   @id @default(uuid())
  profileId      String   @unique
  displayName    String?
  projectsPosted Int      @default(0)
  averageRating  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(uuid())
  nameAr      String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([isActive, sortOrder])
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freelancers FreelancerSkill[]
  projects    ProjectSkill[]
  portfolio   PortfolioSkill[]

  @@index([isActive])
}

model FreelancerSkill {
  freelancerProfileId String
  skillId             String

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerProfileId, skillId])
}

model Project {
  id                 String                  @id @default(uuid())
  title              String
  slug               String                  @unique
  description        String
  categoryId         String
  budgetType         ProjectBudgetType       @default(FIXED)
  budgetMin          Decimal                 @db.Decimal(12, 2)
  budgetMax          Decimal                 @db.Decimal(12, 2)
  currency           String                  @default("LYD")
  experienceLevel    ProjectExperienceLevel  @default(INTERMEDIATE)
  deadline           DateTime?
  workMode           WorkMode                @default(REMOTE)
  cityId             String?
  status             ProjectStatus           @default(DRAFT)
  clientId           String
  acceptedProposalId      String?                 @unique
  publishedAt             DateTime?
  closedAt                DateTime?
  completionRequestedAt   DateTime?
  completionRequestedById String?
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  category         Category       @relation(fields: [categoryId], references: [id])
  city             City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  client           User           @relation("ClientProjects", fields: [clientId], references: [id])
  acceptedProposal Proposal?      @relation("AcceptedProposal", fields: [acceptedProposalId], references: [id])
  completionRequestedBy User?     @relation("CompletionRequests", fields: [completionRequestedById], references: [id], onDelete: SetNull)
  skills           ProjectSkill[]
  proposals        Proposal[]     @relation("ProjectProposals")
  reviews          Review[]
  conversations    Conversation[]
  escrow           Escrow?

  @@index([status])
  @@index([publishedAt])
  @@index([clientId])
  @@index([categoryId])
  @@index([cityId])
  @@index([budgetType])
  @@index([experienceLevel])
  @@index([workMode])
  @@index([createdAt])
}

model ProjectSkill {
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
}

model Proposal {
  id                    String         @id @default(uuid())
  projectId             String
  freelancerId          String
  coverLetter           String
  proposedPrice         Decimal        @db.Decimal(12, 2)
  estimatedDurationDays Int
  status                ProposalStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project            Project        @relation("ProjectProposals", fields: [projectId], references: [id], onDelete: Cascade)
  freelancer         User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  acceptedForProject Project?       @relation("AcceptedProposal")
  conversations      Conversation[]
  escrow             Escrow?

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
  @@index([projectId, status])
  @@index([status])
}

model Conversation {
  id            String    @id @default(uuid())
  projectId     String?
  proposalId    String?   @unique
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]

  @@index([projectId])
  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model PortfolioItem {
  id                  String    @id @default(uuid())
  freelancerProfileId String
  title               String
  description         String
  projectUrl          String?
  completedAt         DateTime?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skills            PortfolioSkill[]
  images            PortfolioImage[]

  @@index([freelancerProfileId])
  @@index([freelancerProfileId, sortOrder])
}

model PortfolioImage {
  id              String   @id @default(uuid())
  portfolioItemId String
  imageUrl        String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@index([portfolioItemId])
}

model PortfolioSkill {
  portfolioItemId String
  skillId         String

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([portfolioItemId, skillId])
}

model Review {
  id             String   @id @default(uuid())
  reviewerId     String
  reviewedUserId String
  projectId      String
  rating         Int
  comment        String?
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviewer     User    @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User    @relation("ReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, reviewedUserId, projectId])
  @@index([reviewedUserId])
  @@index([reviewedUserId, isVisible])
  @@index([projectId])
}

model AdminAuditLog {
  id         String           @id @default(uuid())
  adminId    String
  action     AdminAuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime         @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  targetUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Escrow {
  id               String       @id @default(uuid())
  projectId        String       @unique
  proposalId       String       @unique
  clientId         String
  freelancerId     String
  amount           Decimal      @db.Decimal(12, 2)
  platformFee      Decimal      @db.Decimal(12, 2)
  freelancerPayout Decimal      @db.Decimal(12, 2)
  currency         String       @default("LYD")
  status           EscrowStatus @default(PENDING_FUNDING)
  fundedAt         DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposal     Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  client       User                @relation("EscrowClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer   User                @relation("EscrowFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  transactions EscrowTransaction[]
  dispute      EscrowDispute?
  payments     Payment[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
}

model Payment {
  id                String         @id @default(uuid())
  escrowId          String
  clientId          String
  purpose           PaymentPurpose @default(ESCROW_FUNDING)
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("LYD")
  status            PaymentStatus  @default(PENDING)
  provider          String
  providerReference String?
  checkoutUrl       String?
  idempotencyKey    String         @unique
  metadata          Json?
  failureCode       String?
  failureMessage    String?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  client User   @relation("PaymentClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([clientId])
  @@index([status])
  @@index([providerReference])
  @@index([createdAt])
}

model EscrowTransaction {
  id          String                @id @default(uuid())
  escrowId    String
  type        EscrowTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  currency    String                @default("LYD")
  note        String?
  createdById String?
  createdAt   DateTime              @default(now())

  escrow    Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("EscrowTransactionActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([escrowId])
  @@index([createdAt])
}

model EscrowDispute {
  id           String        @id @default(uuid())
  escrowId     String        @unique
  openedById   String
  reason       String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  escrow     Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  openedBy   User   @relation("EscrowDisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("EscrowDisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
}
