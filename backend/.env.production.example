# Production backend — copy to .env.production and fill secrets (never commit filled file)
# Do not deploy until DNS/hosting is configured.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://libya_prod:CHANGE_ME@postgres-host:5432/libya_freelance?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public marketplace origin
FRONTEND_URL=https://libyanfreelance.ly

# Browser origins allowed to call the API (comma-separated, no *)
CORS_ORIGINS=https://libyanfreelance.ly,https://admin.libyanfreelance.ly

STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=libya-freelance-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=
STORAGE_PORTFOLIO_PUBLIC_BASE_URL=

PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
PAYMENT_SIMULATED_FAILURE=false

EMAIL_FROM=noreply@libyanfreelance.ly
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
