DATABASE_URL="postgresql://libya_freelance:libya_freelance_dev@localhost:5432/libya_freelance?schema=public"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# --- Email (SMTP) ---
# Leave SMTP_* empty locally to disable outbound mail (no tokens logged).
# Production requires a complete SMTP set (validated at startup).
EMAIL_FROM="support@libyanfreelance.ly"
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# Storage (development defaults to local disk)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads/profiles"
STORAGE_PORTFOLIO_PUBLIC_BASE_URL="http://localhost:4000/uploads/portfolio"

# S3-compatible storage (required when STORAGE_DRIVER=s3 in staging/production)
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Payments (default: simulated — replace when a Libyan gateway is chosen)
PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
# Set to true to test failed payment flows in development
PAYMENT_SIMULATED_FAILURE=false
