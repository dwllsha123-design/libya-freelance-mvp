# Railway backend — copy values into Railway service variables (never commit secrets)
# Root Directory in Railway: /backend

NODE_ENV=production
HOST=0.0.0.0
# PORT is injected by Railway — do not hardcode

# --- PostgreSQL (Railway plugin) ---
# Set DATABASE_URL as a Railway REFERENCE VARIABLE, not a literal value:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# (replace "Postgres" with your Postgres service name)
#
# Postgres.DATABASE_URL       -> private network (postgres.railway.internal) — use this
# Postgres.DATABASE_PUBLIC_URL -> TCP proxy, billed egress — local admin tools only
# Never paste a real connection string into this file or any committed file.

# --- Auth ---
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cross-origin Railway staging (*.up.railway.app): use none + secure cookies
AUTH_COOKIE_SAME_SITE=none
# Leave empty on Railway unless using a shared parent cookie domain
AUTH_COOKIE_DOMAIN=

# --- CORS / frontend origins (comma-separated, no spaces after commas) ---
FRONTEND_URL=https://your-frontend.up.railway.app
CORS_ORIGINS=https://your-frontend.up.railway.app,https://www.your-frontend.up.railway.app

# --- Storage (REQUIRED — local disk forbidden in production) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_REGION=auto
S3_BUCKET=libya-freelance-railway
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_BASE_URL=https://your-public-bucket-url.example.com/libya-freelance-railway
# Railway Buckets / MinIO often need path-style; AWS/R2 often use false
S3_FORCE_PATH_STYLE=false

# --- Payments (staging) ---
PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
PAYMENT_SIMULATED_FAILURE=false

# --- Email ---
EMAIL_FROM=noreply@libyanfreelance.ly
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
