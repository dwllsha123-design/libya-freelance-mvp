# Railway backend — copy values into Railway service variables (never commit secrets)
# Root Directory in Railway: /backend

NODE_ENV=production
HOST=0.0.0.0
# PORT is injected by Railway — do not hardcode

# --- PostgreSQL (Railway plugin) ---
# Set DATABASE_URL as a Railway REFERENCE VARIABLE, not a literal value:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# (replace "Postgres" with your Postgres service name)
#
# Postgres.DATABASE_URL       -> private network (postgres.railway.internal) — use this
# Postgres.DATABASE_PUBLIC_URL -> TCP proxy, billed egress — local admin tools only
# Never paste a real connection string into this file or any committed file.

# --- Auth ---
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Refresh cookie (production custom domains) ---
# api.libyanfreelance.ly and the frontends share the registrable domain
# libyanfreelance.ly, so browser requests between them are SAME-SITE and `lax`
# delivers the cookie. Do not use `none` here.
AUTH_COOKIE_SAME_SITE=lax
# Leave EMPTY. The refresh cookie then stays host-only on api.libyanfreelance.ly,
# which is the narrowest scope that works. Only set a value (.libyanfreelance.ly)
# if a non-API subdomain ever has to read the cookie itself.
AUTH_COOKIE_DOMAIN=
#
# Staging exception: on *.up.railway.app the frontend and API are different
# registrable domains, so that setup needs AUTH_COOKIE_SAME_SITE=none.

# --- CORS / frontend origins (comma-separated, no spaces after commas) ---
FRONTEND_URL=https://libyanfreelance.ly
CORS_ORIGINS=https://libyanfreelance.ly,https://www.libyanfreelance.ly,https://admin.libyanfreelance.ly

# --- Storage (REQUIRED — local disk forbidden in production) ---
# Railway Bucket auto-injects these five; the app reads them directly.
# DO NOT set them by hand and do not commit their values:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_DEFAULT_REGION
#   AWS_ENDPOINT_URL
#   AWS_S3_BUCKET_NAME
#
# Add MANUALLY in the Railway backend service — auto-inject does not provide them:
STORAGE_DRIVER=s3

# Railway Buckets are PRIVATE: there are no public object URLs. Point this at the
# API's own media proxy so stored image URLs resolve through the backend.
# Format: https://<backend-domain>/api/media   (no trailing slash)
S3_PUBLIC_BASE_URL=https://api.libyanfreelance.ly/api/media

# Optional. Railway Buckets require virtual-hosted-style addressing, which is the
# default (path style OFF). Only set this if your bucket's Credentials tab says
# to use path-style URLs.
# AWS_S3_URL_STYLE=virtual

# Legacy S3_* names remain supported for the VPS/MinIO deployment and are simply
# unused on Railway: S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY, S3_FORCE_PATH_STYLE

# --- Payments (staging) ---
PAYMENT_DRIVER=simulated
PAYMENT_CURRENCY=LYD
PAYMENT_SIMULATED_FAILURE=false

# --- Email (transactional SMTP — required in production) ---
EMAIL_FROM=support@libyanfreelance.ly
SMTP_HOST=smtp.lsbox.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@libyanfreelance.ly
# Set only in Railway Variables UI — never commit the real password
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
# Never commit the private key. Frontend fetches the PUBLIC key from the API.
PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
PUSH_VAPID_SUBJECT=mailto:support@libyanfreelance.ly
